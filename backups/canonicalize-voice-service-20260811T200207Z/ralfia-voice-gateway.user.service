[Unit]
Description=RalfIA Voice Gateway PWA (:8200)
After=network.target ralfia-mcp.service

[Service]
Type=simple
WorkingDirectory=/home/rlopez/projects/raphiia-openai
EnvironmentFile=-/home/rlopez/projects/raphiia-openai/.env
Environment=RAPHIIA_ROOT=/home/rlopez/projects/raphiia-openai
Environment=PYTHONPATH=/home/rlopez/projects/raphiia-openai
Environment=VOICE_GATEWAY_PORT=8200
ExecStartPre=/bin/bash /home/rlopez/projects/raphiia-openai/scripts/free_port.sh 8200
ExecStart=/home/rlopez/projects/raphiia-openai/venv/bin/python3 /home/rlopez/projects/raphiia-openai/scripts/run_voice_gateway.py
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
