[Unit]
Description=Ollama Sandbox AMD — solo modelos uncensored (:11436, CPU aislado)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3
PrivateDevices=no
Environment=OLLAMA_HOST=0.0.0.0:11436
Environment=OLLAMA_MODELS=/home/rlopez/data/ollama-sandbox-amd/models
Environment=OLLAMA_KEEP_ALIVE=60m
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
# GPU compartida con Ollama productivo :11434 — sandbox usa VRAM pero solo 1 modelo cargado
Environment=HIP_VISIBLE_DEVICES=0
Environment=ROCR_VISIBLE_DEVICES=0
Environment=HSA_OVERRIDE_GFX_VERSION=11.0.0

[Install]
WantedBy=default.target

