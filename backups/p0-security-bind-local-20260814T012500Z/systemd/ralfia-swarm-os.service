[Unit]
Description=RalfIA Swarm-OS CrewAI API (:8100)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform/services/swarm_os
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform/services/swarm_os
Environment=INNEROS_AGENTS_POOL=/home/rlopez/inneros_core/agents_pool
ExecStartPre=/bin/bash -c 'fuser -k 8100/tcp 2>/dev/null || true'
ExecStart=/home/rlopez/inneros/inneros_core/platform/services/swarm_os/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=8

[Install]
WantedBy=default.target
