[Unit]
Description=Sandbox IA Portal AMD
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/home/rlopez/projects/ai-research-sandbox
EnvironmentFile=/home/rlopez/projects/ai-research-sandbox/sandbox.env.amd
ExecStart=/usr/bin/python3 /home/rlopez/projects/ai-research-sandbox/sandbox_portal.py
Restart=on-failure

[Install]
WantedBy=default.target
