# Hackathon Band of Agents — variables obligatorias
# Pegar en .env del servidor (192.168.1.4). NUNCA commitear .env real.

# --- Band (colaboración entre agentes) ---
BAND_REST_URL=https://app.band.ai
BAND_AGENT_ID_ROUTER=
BAND_API_KEY_ROUTER=
BAND_AGENT_ID_MEMORY=
BAND_API_KEY_MEMORY=
BAND_AGENT_ID_ANALYST=
BAND_API_KEY_ANALYST=
BAND_AGENT_ID_DOCUMENTATION=
BAND_API_KEY_DOCUMENTATION=
# Nombres @mention en Band (opcional; deben coincidir con app.band.ai)
BAND_AGENT_NAME_ROUTER=Router
BAND_AGENT_NAME_MEMORY=Memory
BAND_AGENT_NAME_ANALYST=analyst
BAND_AGENT_NAME_DOCUMENTATION=docmaker

# --- Featherless (Router + Memory Agent) ---
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# --- AI/ML API (Analyst + Documentation Agent) ---
AIML_API_KEY=
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=deepseek/deepseek-r1

# --- Puertos hackathon (NO tocar InnerOS :5173) ---
HACKATHON_BAND_PORT=5190
HACKATHON_API_PORT=8200
HACKATHON_API_HOST=0.0.0.0

# --- Memoria real ---
# MongoDB usa MONGO_URI / MONGO_DB del .env principal
RALPHI_DATA_DOCS=/home/rlopez/data/docs
