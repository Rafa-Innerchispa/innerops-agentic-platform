[Unit]
Description=RalfIA bounded MCP profile (%i)
After=network-online.target mongodb.service ralfia-mcp.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
EnvironmentFile=/home/rlopez/inneros/inneros_core/platform/.env
EnvironmentFile=-/home/rlopez/.config/ralphiia/mcp-profiles/%i.env
ExecStartPre=/bin/bash /home/rlopez/inneros/inneros_core/platform/scripts/free_port.sh ${MCP_PORT}
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python -m inneros_core_runtime.mcp_server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
