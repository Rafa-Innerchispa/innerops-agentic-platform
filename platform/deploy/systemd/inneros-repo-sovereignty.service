[Unit]
Description=InnerOS Repository Sovereignty Guardian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
ExecStart=/bin/bash -lc 'while true; do /bin/bash /home/rlopez/inneros/inneros_core/platform/scripts/repo_sovereignty_mirror.sh; /home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/repo_sovereignty_gitlab_sync.py; sleep 21600; done'
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
