[Unit]
Description=RalfIA External Repair Agent (Codex + Antigravity reconcile + auto-claim)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=EXTERNAL_REPAIR_PROVIDERS=codex,antigravity
Environment=EXTERNAL_REPAIR_AUTO_CLAIM=1
Environment=EXTERNAL_REPAIR_OWNER_AUTHORIZED=1
Environment=EXTERNAL_REPAIR_INTERVAL_SEC=120
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 -m inneros_core_runtime.external_repair_agent_daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
