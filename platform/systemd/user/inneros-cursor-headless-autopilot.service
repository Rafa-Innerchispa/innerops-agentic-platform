[Unit]
Description=InnerOS Cursor HA headless autopilot (dual-node lanes)
ConditionPathExists=/home/rlopez/inneros/inneros_core/platform/scripts/cursor_ops_headless_autopilot.py

[Service]
Type=oneshot
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=INNEROS_CURSOR_HA_DUAL=1
Environment=INNEROS_CURSOR_MAX_CONCURRENT=2
Environment=INNEROS_CURSOR_MAX_CONCURRENT_CEILING=8
Environment=INNEROS_CURSOR_AUTO_CLAIM=1
Environment=INNEROS_CURSOR_HEADLESS_EXECUTE=1
Environment=INNEROS_CURSOR_DISPATCH_MODE=auto
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/cursor_ops_headless_autopilot.py
TimeoutStartSec=180
