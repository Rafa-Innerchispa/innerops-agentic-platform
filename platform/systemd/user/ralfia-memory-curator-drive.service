[Unit]
Description=RalfIA Memory Curator Drive — batch único (ahorro energía)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=MONGO_URI_PRIMARY=mongodb://192.168.1.4:27017/
Environment=MEMORY_CURATOR_STRICT=1
Environment=MEMORY_CURATOR_MODEL=qwen2.5:7b
Environment=MEMORY_CURATOR_NODE=amd
Environment=OLLAMA_KEEP_ALIVE=5m
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/run_memory_curator.py --once --limit 15 --roots '/home/rlopez/data/google_drive/PC-Doctor- Historico/Clientes' /home/rlopez/data/google_drive

[Install]
WantedBy=default.target
