[Unit]
Description=InnerOS Mongo coordination dump (pcdoctor_swarm) to disk and Google Drive
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=INNEROS_NODE_ROLE=intel
Environment=INNEROS_MONGO_BACKUP_MODE=core
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
ExecStart=/home/rlopez/inneros/inneros_core/platform/scripts/inneros_mongo_coordination_backup.sh
TimeoutStartSec=3600