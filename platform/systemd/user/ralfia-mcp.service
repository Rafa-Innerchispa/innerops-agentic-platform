[Unit]
Description=RalfIA MCP Ecosystem (:8102) — innerOS canonical
After=network.target
Documentation=file:///home/rlopez/data/ai_coordination/HUB/MCP_ECOSYSTEM.md

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
Environment=INNEROS_CORE_ROOT=/home/rlopez/inneros/inneros_core
Environment=RAPHIIA_ROOT=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=MCP_PORT=8102
Environment=MCP_HOST=0.0.0.0
ExecStartPre=/bin/bash /home/rlopez/inneros/inneros_core/platform/scripts/free_port.sh 8102
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 -m inneros_core_runtime.mcp_server
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
