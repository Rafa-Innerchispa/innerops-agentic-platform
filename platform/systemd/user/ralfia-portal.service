[Unit]
Description=Ralphi IA Control Center (:2002) + redirect :8800
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PORTAL_PORT=2002
Environment=RAPHIIA_ROOT=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
ExecStart=/home/rlopez/inneros/inneros_core/platform/run_ops.sh
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
