[Unit]
Description=RalfIA Voice Gateway PWA (:8200)
After=network.target ralfia-mcp.service

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
Environment=RAPHIIA_ROOT=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=VOICE_GATEWAY_PORT=8200
ExecStartPre=/bin/bash /home/rlopez/inneros/inneros_core/platform/scripts/free_port.sh 8200
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/run_voice_gateway.py
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
