[Unit]
Description=RalfIA AG-42 Service Guardian cycle (local self-heal)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=RALFIA_SELF_HEAL=1
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/run_service_guardian_cycle.py

[Install]
WantedBy=default.target
