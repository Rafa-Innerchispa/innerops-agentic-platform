[Unit]
Description=RalfIA AG-58 Agent Activity Report
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=MONGO_URI_PRIMARY=mongodb://192.168.1.4:27017/
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/run_agent_activity_report.py --hours 6

[Install]
WantedBy=default.target
