[Unit]
Description=InnerOS Owner Push (PWA + decide API, sin Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env.ops-notify
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python -m uvicorn inneros_core_runtime.owner_push_app:app --host 0.0.0.0 --port 8244
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target