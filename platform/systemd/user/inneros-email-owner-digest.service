[Unit]
Description=InnerOS email owner digest (Telegram + email delivery, with DELIVERY evidence line)
ConditionPathExists=/home/rlopez/inneros/inneros_core/platform/scripts/run_email_owner_digest.py
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=INNEROS_CORE_ROOT=/home/rlopez/inneros/inneros_core
Environment=INNEROS_WHATSAPP_NOTIFICATIONS=0
Environment=NOTIFY_OPS_TELEGRAM=1
Environment=RALFIA_OPS_AUTH_EMAIL_TO=rafagye@gmail.com
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env.ops-notify
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env.telegram-load
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/run_email_owner_digest.py --hours 24 --limit 25
TimeoutStartSec=300

[Install]
WantedBy=default.target
