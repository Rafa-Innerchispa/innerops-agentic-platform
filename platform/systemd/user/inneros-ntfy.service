[Unit]
Description=ntfy push server (InnerOS owner, self-hosted Intel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
ExecStart=/usr/local/bin/ntfy serve --config /home/rlopez/inneros/inneros_core/platform/config/ntfy/server.yml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target