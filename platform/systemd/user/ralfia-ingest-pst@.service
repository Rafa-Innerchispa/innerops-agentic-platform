[Unit]
Description=RalfIA AG-34 PST ingest worker %i (Intel readpst)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=MONGO_URI_PRIMARY=mongodb://192.168.1.4:27017/
Environment=PST_IMPORT_WORKERS=8
Environment=INGEST_WORKER_ID=pst-%i
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/run_local_ingest_fleet.py --pst-only --max-cycles 50000 --sleep 0
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
