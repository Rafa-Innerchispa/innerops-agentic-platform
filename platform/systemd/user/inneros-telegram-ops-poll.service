[Unit]
Description=InnerOS Telegram OPS long-poll (owner auth + chat_id)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env
EnvironmentFile=-/home/rlopez/inneros/inneros_core/platform/.env.ops-notify
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 /home/rlopez/inneros/inneros_core/platform/scripts/telegram_ops_poll.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
