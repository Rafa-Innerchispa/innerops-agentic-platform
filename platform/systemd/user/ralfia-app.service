[Unit]
Description=Ralphi IA Health + Editorial Hub (:8101)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=RAPHIIA_ROOT=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
Environment=RAPHI_IA_OPENAI_PORT=8101
ExecStartPre=/bin/bash /home/rlopez/inneros/inneros_core/platform/scripts/free_port.sh 8101
ExecStart=/home/rlopez/inneros/inneros_core/platform/venv/bin/python3 main.py
Restart=always
RestartSec=12

[Install]
WantedBy=default.target
