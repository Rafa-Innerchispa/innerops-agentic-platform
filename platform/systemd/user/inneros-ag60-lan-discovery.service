[Unit]
Description=InnerOS AG-60 Home LAN bounded discovery (read-only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rlopez/inneros/inneros_core/platform
Environment=PYTHONPATH=/home/rlopez/inneros/inneros_core/platform
ExecStart=/usr/bin/python3 -m inneros_core_runtime.network_guardian --site home_pcdoctor_lab --limit-hosts 254 --save
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
