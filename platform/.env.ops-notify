# Ops owner notifications — load alongside .env (telegram + fallbacks)
NOTIFY_OPS_TELEGRAM=1
NOTIFY_OPS_TELEGRAM_DIRECT_ON_CREATE=0
NOTIFY_OPS_TELEGRAM_SECONDARY=0
NOTIFY_OPS_PRIMARY=inneros_push
NOTIFY_OPS_INNEROS_PUSH=1
NOTIFY_OPS_INNEROS_LIFECYCLE=1
NOTIFY_OPS_AUTH_HA=0
INNEROS_NTFY_URL=http://127.0.0.1:2586
INNEROS_NTFY_TOPIC=ralfia-owner-ops
# URL única casa + fuera (Tailscale Intel; ver docs RALFIA_TS_INTEL=100.94.99.12)
INNEROS_OWNER_PUSH_PUBLIC_URL=http://100.94.99.12:8244
NOTIFY_OPS_CREATE_AUTHORIZATION=1
NOTIFY_OPS_TASKS=1
NOTIFY_OPS_HA_OUTCOMES=0
NOTIFY_OPS_HA_SCOUT=0
NOTIFY_OPS_OWNER_SUMMARY_TELEGRAM=0
OPS_HA_PUSH_DAILY_CAP=120
OPS_HA_PUSH_OWNER_AUTH_EXEMPT=1
NOTIFY_OPS_CHANNELS=email
NOTIFY_OPS_AUTH_EMAIL_FALLBACK=1
WHATSAPP_AMD_SEND_ENABLED=0
RALFIA_ALERTS_VIA_NODE=primary
OWNER_VOICE_ALERT_ENABLED=0
OWNER_PRESENCE_REGION=ecuador
# TELEGRAM_BOT_TOKEN=from BotFather
# TELEGRAM_OWNER_CHAT_ID=your chat id (or send /start to bot once polling runs)
# UCM_CLICK_TO_CALL_URL=http://192.168.x.x/cgi-bin/...
# OWNER_MOBILE_EC=593XXXXXXXXX
NOTIFY_OPS_INTERNAL_CREATE=1
NOTIFY_COOLDOWN_SEC=20
RALFIA_OPS_AUTH_EMAIL_TO=rafagye@gmail.com
OWNER_NOTIFY_EMAIL=rafagye@gmail.com
