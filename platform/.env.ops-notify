# TELEGRAM_OWNER_CHAT_ID=your chat id (or send /start to bot once polling runs)
# UCM_CLICK_TO_CALL_URL=http://192.168.x.x/cgi-bin/...
# OWNER_MOBILE_EC=593XXXXXXXXX
NOTIFY_OPS_INTERNAL_CREATE=1
NOTIFY_COOLDOWN_SEC=20
RALFIA_OPS_AUTH_EMAIL_TO=rafagye@gmail.com
