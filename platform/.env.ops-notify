# Ops owner notifications — load alongside .env (telegram + fallbacks)
NOTIFY_OPS_TELEGRAM=1
NOTIFY_OPS_CHANNELS=telegram,email
NOTIFY_OPS_AUTH_EMAIL_FALLBACK=1
WHATSAPP_AMD_SEND_ENABLED=0
RALFIA_ALERTS_VIA_NODE=primary
OWNER_VOICE_ALERT_ENABLED=0
OWNER_PRESENCE_REGION=ecuador
