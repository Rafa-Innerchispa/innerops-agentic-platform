# RaphiIA-OpenAI — MCP bridge (sin OpenAI API en servidor)

# HTTP status / health
RAPHI_IA_OPENAI_PORT=8101
RAPHI_IA_OPENAI_HOST=0.0.0.0
RAPHI_IA_PUBLIC_URL=http://192.168.1.4:8101

# MCP Streamable HTTP (ChatGPT Connectors)
MCP_PORT=8102
MCP_HOST=0.0.0.0
MCP_PUBLIC_URL=https://sworn-profusely-alongside.ngrok-free.dev/raphiia-mcp
MCP_API_KEY=change-me-long-random-secret

# OAuth for ChatGPT MCP connector
OAUTH_PORT=8103
OAUTH_HOST=0.0.0.0
OAUTH_ISSUER=https://sworn-profusely-alongside.ngrok-free.dev/raphiia-auth
OAUTH_MCP_RESOURCE=https://sworn-profusely-alongside.ngrok-free.dev/raphiia-mcp/mcp
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1

# MongoDB compartida (Swarm-OS / RalfyIA)
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB=pcdoctor_swarm

# Swarm-OS (lectura contexto opcional + poll email IMAP)
SWARM_API_BASE=http://127.0.0.1:8100

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=PC Doctor
# --- RalfIA Voice Gateway (PWA voz.pcdoctor.ai) ---
VOICE_AUTH_REQUIRED=1
VOICE_SESSION_SECRET=
VOICE_ADMIN_USERS=rlopez,admin,rafagye@gmail.com,rafagye
VOICE_NOTIFY_EMAIL=rafagye@gmail.com
VOICE_PUBLIC_URL=https://voz.pcdoctor.ai
NOTIFY_WEBHOOK_URL=
# Google OAuth login (consola: OAuth 2.0 Client ID tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VOICE_OAUTH_REDIRECT_URI=https://voz.pcdoctor.ai/api/voice/auth/google/callback

# --- Voice chat backend (Gemini / Ollama / vLLM) ---
# auto = Gemini si GOOGLE_API_KEY, si no vLLM si VOICE_USE_VLLM=1, si no Ollama
VOICE_CHAT_BACKEND=auto
GEMINI_TEXT_MODEL=gemini-2.5-flash
VOICE_HISTORY_LIMIT=40
# Prioridad servidor local AMD (Ollama) antes que Gemini cloud
VOICE_LOCAL_FIRST=1
# Política GPU dual-nodo: vLLM AMD primario, Ollama chat Intel vía router
VLLM_PRIMARY=1
OLLAMA_AMD_EMBEDDINGS_ONLY=1
# vLLM pip ROCm bloqueado en cp314 (2026-08) — dejar en 0 hasta Docker o wheels nuevos
VOICE_USE_VLLM=0
VLLM_URL=http://127.0.0.1:8000
VLLM_MODEL=qwen2.5:14b-instruct-q4_K_M
VOICE_CHAT_MODEL=qwen2.5:14b-instruct-q4_K_M
VOICE_HEAVY_MODEL=qwen2.5:32b-instruct-q4_K_M
OLLAMA_DIRECT_URL=http://127.0.0.1:11434

# --- Notificaciones WhatsApp (Evolution API directo — sin n8n) ---
EVOLUTION_BASE_URL=http://192.168.1.4:8082
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=RalphiIA-pcdoctor
# Segundo número AMD (.5) — chip distinto
EVOLUTION_AMD_BASE_URL=http://192.168.1.5:8082
EVOLUTION_AMD_INSTANCE=RalfIA-amd-backup
EVOLUTION_DEFAULT_NODE=primary
NOTIFY_WHATSAPP_TO=593999059000
NOTIFY_COORDINATION=1
NOTIFY_EMAIL_POLL=1
NOTIFY_MODULE_DOWN=1
NOTIFY_COOLDOWN_SEC=300

# Política anti-bloqueo WhatsApp (1=activo). Mantener en 0 durante warm-up del chip AMD.
WHATSAPP_STATUS_ENABLED=0
WHATSAPP_AMD_SEND_ENABLED=0
WHATSAPP_AMD_STATUS_ENABLED=0

# --- Notion API (push RalfIA → Notion; sin créditos OpenAI) ---
# Integration token: https://www.notion.so/my-integrations
NOTION_API_TOKEN=
# page_id de la carpeta/sección donde crear la DB (OS Central → RalfIA Docs)
NOTION_DOCS_PARENT_PAGE_ID=
# database_id tras bootstrap_notion_schema (Docs — RalfIA Numerados)
NOTION_DOCS_DATABASE_ID=
# DB RalfIA Coordination (órdenes ↔ ops_tasks) — bajo Bases Maestras
NOTION_COORDINATION_DATABASE_ID=
# opcional: DB Audit Log separada
NOTION_AUDIT_DATABASE_ID=
NOTION_VERSION=2022-06-28
NOTION_MAX_DOC_CHARS=50000

# --- Contifico (import read-only → migración a MOD-ACCOUNTING propio) ---
CONTIFICO_API_KEY=
CONTIFICO_COMPANY_TOKEN=
CONTIFICO_API_BASE=https://api.contifico.com/sistema/api/v1

# OPENAI_API_KEY=   # NO usar — evita coste API; LLM = ChatGPT del usuario

# --- Editorial LinkedIn (ver docs/GOOGLE_API_KEYS.md) ---
# Claves AI Studio 2026: prefijo AQ.... (nuevo) o AIzaSy... (legacy). Ambas válidas.
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias de GOOGLE_API_KEY
IMAGE_GEN_MODEL=imagen-3.0-generate-002
IMAGE_GEN_PROVIDER=google
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
EDITORIAL_MEDIA_ROOT=/home/rlopez/data/media/linkedin

