# Example ONLY. Never put real API keys or registration tokens in a repository.
# Switch Console local server default (verify at /health before running):
SWITCH_URL=http://127.0.0.1:8000
# Set these after room and participant discovery:
SWITCH_ROOM_ID=!your-room:localhost
SWITCH_APPROVER_ID=@your-switch-user:localhost
# Optional model when available on an SSH tunnel or local OpenAI-compatible runtime:
# LOCAL_MODEL_URL=http://127.0.0.1:18780/v1
# LOCAL_MODEL_NAME=actual-served-model-id

# REAL home lab demo (fill these privately in your process environment)
